# ThinkViva environment variables
# Copy this file to .env and fill in real values. Never commit your .env.

# --- Required ---
# MongoDB connection string (local mongod or MongoDB Atlas)
MONGODB_URI=your-mongodb-connection-string
# Port the Express server listens on (defaults to 3000 if unset)
PORT=3000
# Token that gates all /api/admin/* routes and the /admin dashboard (required, no default)
ADMIN_TOKEN=your-strong-admin-token

# --- Email (optional; transactional email is skipped if unset) ---
# SMTP credentials for Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# From/routing addresses (fall back to sensible defaults if unset)
FROM_EMAIL=no-reply@thinkviva.org
ADMIN_EMAIL=info@thinkviva.org
BOOKINGS_EMAIL=bookings@thinkviva.org

# --- Integrations (optional) ---
# Resend API key (reserved for future email provider use)
RESEND_API_KEY=your-resend-api-key
# Groq API key — enables AI CV screening in the admin dashboard
GROQ_API_KEY=your-groq-api-key
# Link used in review-request emails
GOOGLE_REVIEW_URL=your-google-review-url
